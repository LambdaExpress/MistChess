# Copy this file to .env for local development. Start-MistChess.ps1 loads it
# without executing its contents. Never commit the populated .env file.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__MistChess=Host=localhost;Port=5432;Database=mistchess_dev;Username=mistchess_app;Password=<generated-local-app-password>
# Local administrator credentials belong in .NET User Secrets; production injects these at process scope.
# Admin__Username=<admin-username>
# Admin__PasswordHash=<aspnet-identity-password-hash>
# Integration tests require a separate maintenance connection string.
MISTCHESS_TEST_ADMIN_CONNECTION_STRING=Host=localhost;Port=5432;Database=postgres;Username=mistchess_app;Password=<local-app-password>
# Browser origins allowed to open SignalR WebSockets; repeat with __1 as needed.
WebSockets__AllowedOrigins__0=http://127.0.0.1:5173
WebSockets__AllowedOrigins__1=http://localhost:5173
# Set each non-loopback reverse proxy explicitly; repeat with __1, __2, and so on.
ReverseProxy__KnownProxies__0=<proxy-ip-address>
